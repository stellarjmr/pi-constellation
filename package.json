{
  "name": "pi-amp-harness",
  "version": "0.1.0",
  "description": "An Amp-inspired two-mode agent harness for Pi with isolated specialist subagents.",
  "type": "module",
  "license": "MIT",
  "author": "stellarjmr",
  "contributors": ["stellarjmr"],
  "homepage": "https://github.com/stellarjmr/pi-amp-harness#readme",
  "bugs": "https://github.com/stellarjmr/pi-amp-harness/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stellarjmr/pi-amp-harness.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "agent-harness",
    "subagents"
  ],
  "files": [
    "index.ts",
    "extensions/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
